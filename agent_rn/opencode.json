{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "build",

  "permission": {
    "external_directory": {
      "D:/HM/flutter-library-workflow/**": "allow",
      "D:/rn/**": "allow"
    }
  },

  "agent": {
    "primary-01-analysis": {
      "description": "分析 React Native 模块的现状（类型、架构、TurboModule/Fabric 组件、依赖、权限、功能），输出 01-analysis.json 和 01-analysis-report.md。仅分析现状，不涉及具体鸿蒙化方案。",
      "mode": "primary",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/primary-01-analysis.md}",
      "permission": {
        "task": {
          "sub-doc-search": "allow",
          "sub-rn-adapted-library": "allow"
        },
        "websearch": "allow",
        "webfetch": "allow"
      }
    },
    "primary-02-planning": {
      "description": "基于 01-analysis.json 为每个功能找到鸿蒙 API 和实现方案，制定 TurboModule/Fabric 组件/C++ 实现策略，输出 02-planning.json",
      "mode": "primary",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/primary-02-planning.md}",
      "permission": {
        "task": {
          "sub-doc-search": "allow"
        },
        "websearch": "allow",
        "webfetch": "allow"
      }
    },
    "primary-03-coding-library": {
      "description": "根据模块类型加载对应 Skill，编写鸿蒙 ETS/C++ 库代码（TurboModule、Fabric 组件等），以编译通过为结束标识",
      "mode": "primary",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/primary-03-coding-library.md}",
      "bash_timeout_ms": 1200000,
      "permission": {
        "task": {
          "sub-doc-search": "allow"
        },
        "bash": "allow",
        "websearch": "allow",
        "webfetch": "allow"
      }
    },
    "primary-04-testing": {
      "description": "验证与修复 — 构建 Example 工程覆盖所有已实现功能，hvigorw assembleHap 编译通过 + 编排 Subagent 执行测试生成/设备验证/库修复",
      "mode": "primary",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/primary-04-testing.md}",
      "gate_script": "scripts/gate-testing.js",
      "bash_timeout_ms": 1800000,
      "permission": {
        "task": {
          "sub-doc-search": "allow",
          "sub-static-analysis": "allow",
          "sub-integration-test": "allow",
          "sub-device-verify": "allow",
          "sub-lib-fixer": "allow"
        },
        "bash": "allow",
        "websearch": "allow",
        "webfetch": "allow"
      }
    },
    "primary-05-summary": {
      "description": "汇总全部适配阶段产物，评分并生成分层报告与集成指南（含 Autolinking 配置、Package 注册等）",
      "mode": "primary",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/primary-05-summary.md}",
      "tools": {
        "bash": true,
        "write": true,
        "edit": true
      }
    },
    "sub-doc-search": {
      "description": "文档与 API 搜索（鸿蒙文档 / SDK API / Web）",
      "mode": "subagent",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/sub-doc-search.md}",
      "tools": {
        "bash": true,
        "websearch": true,
        "webfetch": true,
        "write": false,
        "edit": false
      }
    },
    "sub-static-analysis": {
      "description": "10 项静态深度分析（7 基础 + 3 库正确性检测）",
      "mode": "subagent",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/sub-static-analysis.md}",
      "tools": {
        "bash": true,
        "write": false,
        "edit": false
      }
    },
    "sub-integration-test": {
      "description": "基于 implemented_methods 生成 Jest / @testing-library/react-native 测试代码",
      "mode": "subagent",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/sub-integration-test.md}",
      "tools": {
        "bash": true,
        "write": false,
        "edit": false
      }
    },
    "sub-device-verify": {
      "description": "OHOS 设备上安装 HAP、运行 Jest 测试、收集验证结果",
      "mode": "subagent",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/sub-device-verify.md}",
      "tools": {
        "bash": true,
        "write": false,
        "edit": false
      }
    },
    "sub-lib-fixer": {
      "description": "基于分析/验证结果修复库代码",
      "mode": "subagent",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/sub-lib-fixer.md}",
      "tools": {
        "bash": true,
        "write": true,
        "edit": true
      },
      "permission": {
        "task": {
          "sub-doc-search": "allow"
        }
      }
    },
    "sub-rn-adapted-library": {
      "description": "查找已完成鸿蒙（OpenHarmony）适配的 React Native 三方库",
      "mode": "subagent",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/sub-rn-adapted-library.md}",
      "tools": {
        "bash": true,
        "websearch": false,
        "webfetch": false,
        "write": false,
        "edit": false
      }
    }
  }
}
