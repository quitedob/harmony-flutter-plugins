{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rn-ohos-adaptation/04-testing.schema.json",
  "title": "Testing Stage Output",
  "description": "React Native 模块鸿蒙适配示例验证阶段（阶段4）的产物。记录示例工程搭建、方法覆盖、编译状态、静态分析、设备运行态验证和库代码修复。",
  "version": "3.0.0",
  "type": "object",
  "required": [
    "example_build_status",
    "example_source",
    "files_modified",
    "build_attempts",
    "method_coverage"
  ],
  "properties": {
    "example_build_status": { "type": "string", "enum": ["pass", "fail", "skip"] },
    "example_source": { "type": "string", "enum": ["existing_adapted", "new_created", "skip"] },
    "deps_without_ohos": { "type": "array", "items": { "type": "string" } },
    "fallback_applied": {
      "type": "array",
      "items": { "$ref": "#/$defs/FallbackEntry" }
    },
    "files_created": { "type": "array", "items": { "type": "string" } },
    "files_modified": { "type": "array", "items": { "type": "string" } },
    "build_attempts": { "type": "integer", "minimum": 0 },
    "method_coverage": { "$ref": "#/$defs/MethodCoverage" },
    "compilation_fixes": {
      "type": "array",
      "items": { "$ref": "#/$defs/CompilationFix" }
    },
    "runtime_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/RuntimeCheck" }
    },
    "library_fixes": {
      "type": "array",
      "items": { "$ref": "#/$defs/LibraryFix" }
    },
    "build_log_summary": { "type": "string" },
    "test_scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/TestScenario" }
    },
    "device_test_status": { "type": "string", "enum": ["pass", "partial", "fail", "skipped"] },
    "device_test_skip_reason": { "type": "string" },
    "device_test_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/DeviceTestResult" }
    },
    "device_crash_detected": { "type": "boolean" },
    "device_crash_log": { "type": "string" },
    "device_test_attempts": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false,
  "$defs": {
    "FallbackEntry": {
      "type": "object",
      "required": ["dep", "original_call", "fallback"],
      "properties": {
        "dep": { "type": "string" },
        "original_call": { "type": "string" },
        "fallback": { "type": "string" }
      },
      "additionalProperties": false
    },
    "MethodCoverage": {
      "type": "object",
      "required": ["total_methods", "covered_methods", "coverage_rate"],
      "properties": {
        "total_methods": { "type": "integer", "minimum": 0 },
        "covered_methods": { "type": "integer", "minimum": 0 },
        "uncovered_methods": { "type": "array", "items": { "type": "string" } },
        "coverage_rate": { "type": "string" }
      },
      "additionalProperties": false
    },
    "CompilationFix": {
      "type": "object",
      "required": ["attempt", "error", "fix"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "error": { "type": "string" },
        "fix": { "type": "string" }
      },
      "additionalProperties": false
    },
    "RuntimeCheck": {
      "type": "object",
      "required": ["check_type", "status"],
      "properties": {
        "check_type": {
          "type": "string",
          "enum": [
            "turbo_module_consistency",
            "param_type_match",
            "permission_completeness",
            "async_error_handling",
            "missing_module_risk",
            "null_safety",
            "event_emitter_lifecycle",
            "behavior_equivalence",
            "return_structure_match",
            "api_call_validity"
          ]
        },
        "status": { "type": "string", "enum": ["pass", "warning", "fail"] },
        "details": { "type": "string" },
        "method_details": {
          "type": "array",
          "items": { "$ref": "#/$defs/MethodCheckDetail" }
        }
      },
      "additionalProperties": false
    },
    "MethodCheckDetail": {
      "type": "object",
      "required": ["method", "result"],
      "properties": {
        "method": { "type": "string" },
        "result": { "type": "string", "enum": ["equivalent", "partial", "divergent", "stub", "match", "mismatch", "valid", "invalid"] },
        "issue": { "type": "string" }
      },
      "additionalProperties": false
    },
    "DeviceTestResult": {
      "type": "object",
      "required": ["method", "result"],
      "properties": {
        "method": { "type": "string" },
        "result": { "type": "string", "enum": ["pass", "assert_fail", "error", "not_executed"] },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "LibraryFix": {
      "type": "object",
      "required": ["file", "issue", "fix"],
      "properties": {
        "file": { "type": "string" },
        "issue": { "type": "string" },
        "fix": { "type": "string" }
      },
      "additionalProperties": false
    },
    "TestScenario": {
      "type": "object",
      "required": ["name", "methods_tested"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "methods_tested": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
