{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ohos-adaptation/01-analysis.schema.json",
  "title": "SDK Analysis Marker Output",
  "description": "01 阶段 JSON：仅保留前端展示、阶段定位和后续阶段入口。详细能力模型、源码证据、模块 PRD 写入 Markdown。",
  "version": "3.0.0",
  "type": "object",
  "required": [
    "sdk_name",
    "sdk_version",
    "description",
    "conversion_source",
    "source_layout",
    "sdk_feature_tags",
    "architecture_type",
    "public_api_surface",
    "difficulty_level",
    "prd_path",
    "work_unit_prd_dir",
    "work_unit_prd_index_path"
  ],
  "properties": {
    "sdk_name": { "type": "string" },
    "sdk_version": { "type": "string" },
    "description": { "type": "string" },
    "conversion_source": {
      "type": "object",
      "required": ["kind", "relative_root"],
      "properties": {
        "kind": { "type": "string", "enum": ["android", "ios", "ts_js", "unknown"] },
        "relative_root": { "type": "string" }
      },
      "additionalProperties": false
    },
    "source_layout": {
      "type": "object",
      "required": [
        "input_path_classification",
        "sdk_repo_root",
        "gradle_root",
        "included_modules",
        "primary_sdk_modules",
        "sample_modules",
        "analysis_scope",
        "modification_scope",
        "verification_targets"
      ],
      "properties": {
        "input_path_classification": {
          "type": "string",
          "enum": ["workspace_root", "repository_collection", "sdk_repo_root", "gradle_root", "module_dir", "unknown"]
        },
        "workspace_root": { "type": "string" },
        "outer_repo_root": { "type": "string" },
        "sdk_repo_root": { "type": "string" },
        "gradle_root": { "type": "string" },
        "settings_file": { "type": "string" },
        "gradle_wrapper": { "type": "string" },
        "included_modules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gradle_path", "project_dir", "type", "role", "active"],
            "properties": {
              "gradle_path": { "type": "string" },
              "project_dir": { "type": "string" },
              "build_file": { "type": "string" },
              "type": { "type": "string" },
              "role": { "type": "string" },
              "active": { "type": "boolean" },
              "publish_candidate": { "type": "boolean" },
              "evidence": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "primary_sdk_modules": { "type": "array", "items": { "type": "string" } },
        "sample_modules": { "type": "array", "items": { "type": "string" } },
        "inactive_module_dirs": { "type": "array", "items": { "type": "string" } },
        "auxiliary_dirs": { "type": "array", "items": { "type": "string" } },
        "analysis_scope": { "type": "array", "items": { "type": "string" } },
        "modification_scope": { "type": "array", "items": { "type": "string" } },
        "excluded_paths": { "type": "array", "items": { "type": "string" } },
        "verification_targets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "path", "purpose"],
            "properties": {
              "name": { "type": "string" },
              "path": { "type": "string" },
              "command": { "type": "string" },
              "purpose": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "detection_notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "sdk_feature_tags": {
      "type": "object",
      "required": ["has_ux", "has_jni", "has_ndk", "has_file_io", "has_reflection"],
      "properties": {
        "has_ux": { "type": "boolean" },
        "has_jni": { "type": "boolean" },
        "has_ndk": { "type": "boolean" },
        "has_file_io": { "type": "boolean" },
        "has_reflection": { "type": "boolean" },
        "has_annotation_processing": { "type": "boolean" },
        "has_network": { "type": "boolean" },
        "has_local_storage": { "type": "boolean" },
        "has_broadcast": { "type": "boolean" },
        "has_device_info": { "type": "boolean" },
        "has_push_service": { "type": "boolean" },
        "native_source_available": { "type": "boolean" },
        "extra_labels": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "architecture_type": { "type": "string", "enum": ["single_module", "multi_module", "layered", "unknown"] },
    "public_api_surface": {
      "type": "object",
      "required": ["count", "class_count", "interface_count", "method_count"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "class_count": { "type": "integer", "minimum": 0 },
        "interface_count": { "type": "integer", "minimum": 0 },
        "method_count": { "type": "integer", "minimum": 0 },
        "callback_count": { "type": "integer", "minimum": 0 },
        "data_model_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "difficulty_level": { "type": "string", "enum": ["L1", "L2", "L3", "L4", "L5", "unknown"] },
    "prd_path": { "type": "string" },
    "work_unit_prd_dir": { "type": "string" },
    "work_unit_prd_index_path": { "type": "string" },
    "platform_coupling_summary": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
