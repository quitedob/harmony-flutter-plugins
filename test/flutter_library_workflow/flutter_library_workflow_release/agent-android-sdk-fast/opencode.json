{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "primary-sdk-01-analysis",
  "lsp": false,
  "permission": {
    "bash": "allow",
    "edit": {
      "*": "allow",
      "../*": "deny",
      "?:/*": "deny",
      "//*": "deny"
    },
    "write": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "skill": "allow",
    "websearch": "allow",
    "todowrite": "allow",
    "external_directory": {
      "**/flutter-library-workflow/**": "allow",
      "**/DevEco Studio/sdk/**": "allow",
      "**/openharmony/**": "allow",
      "**/skills/**": "allow"
    }
  },
  "agent": {
    "primary-00-orchestrator": {
      "description": "Android SDK → 鸿蒙 HAR 适配统一入口（编排现状分析/代码实现/编码校验 3 阶段）",
      "mode": "primary",
      "prompt": "{file:./.claude/prompts/primary-00-orchestrator.md}"
    },
    "primary-sdk-01-analysis": {
      "description": "现状分析",
      "mode": "primary",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/primary-sdk-01-analysis.md}"
    },
    "primary-sdk-02-implementation": {
      "description": "代码编写",
      "mode": "primary",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/primary-sdk-02-implementation.md}"
    },
    "primary-sdk-03-validation": {
      "description": "编码校验",
      "mode": "primary",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/primary-sdk-03-validation.md}"
    },
    "primary-sdk-04-quality-review": {
      "description": "质量审查",
      "mode": "primary",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/primary-sdk-04-quality-review.md}"
    },
    "primary-sdk-05-quality-fix": {
      "description": "质量修复",
      "mode": "primary",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/primary-sdk-05-quality-fix.md}"
    },
    "primary-sdk-test-design": {
      "description": "用例设计",
      "mode": "primary",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/test/sdk-test-design-master.md}"
    },
    "primary-sdk-demo-gen": {
      "description": "HAR Demo 生成（生成可安装的OHOS真机测试Demo）",
      "mode": "primary",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/test/primary-sdk-demo-gen.md}"
    },
    "upgrade-01-analysis": {
      "description": "SDK 升级分析",
      "mode": "primary",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/upgrade/upgrade-01-analysis.md}"
    },
    "upgrade-02-coding": {
      "description": "SDK 升级代码编写",
      "mode": "primary",
      "hidden": true,
      "prompt": "{file:./.claude/prompts/upgrade/upgrade-02-coding.md}"
    }
  }
}
