{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "rn-ohos-fast lessons index",
  "description": "瘦索引：列出全部 category 分片 + 何时加载。02/03 开工只读本文件，再按 plugin_type+stage（必要时结合 load_when）命中的 category 加载对应分片，实现按需加载。",
  "type": "object",
  "required": ["version", "updated_at", "categories"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "file", "title", "stage", "plugin_type", "count", "load_when"],
        "additionalProperties": false,
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "stage": { "type": "array", "minItems": 1, "items": { "enum": ["coding", "validation", "both"] } },
          "plugin_type": { "type": "array", "minItems": 1, "items": { "enum": ["js-only", "turbo", "fabric", "cpp", "all"] } },
          "count": { "type": "integer", "minimum": 1 },
          "load_when": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
