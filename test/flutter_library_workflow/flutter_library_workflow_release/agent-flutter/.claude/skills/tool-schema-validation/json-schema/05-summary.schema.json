{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ohos-adaptation/05-summary.schema.json",
  "title": "Summary Stage Output",
  "description": "Flutter 插件鸿蒙适配总结阶段（阶段5）的产物。聚合前 4 阶段数据，包含质量评分、方法覆盖率、适配概况、风险项、统计数据和改进建议。",
  "version": "3.0.0",
  "type": "object",
  "required": [
    "plugin_name",
    "status",
    "quality_score",
    "coverage",
    "implemented_methods",
    "not_implemented",
    "files_created",
    "files_modified",
    "build_status",
    "example_status"
  ],
  "properties": {
    "plugin_name": {
      "type": "string",
      "description": "插件名称"
    },
    "status": {
      "type": "string",
      "description": "适配结果总体状态。success: 评分 A/B; partial: 评分 C; failed: 评分 D",
      "enum": ["success", "partial", "failed"]
    },
    "quality_score": {
      "type": "string",
      "description": "质量评分。A: 100%覆盖+全编译通过+检测全pass; B: ≥80%覆盖+编译通过+少量warning; C: ≥50%覆盖+编译通过; D: <50%覆盖或编译未通过",
      "enum": ["A", "B", "C", "D"]
    },
    "summary": {
      "$ref": "#/$defs/Summary",
      "description": "插件适配概况（聚合自 01-analysis 和 02-planning）"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "implemented_methods": {
      "type": "array",
      "description": "已实现的方法列表（聚合自 03-coding-library）",
      "items": {
        "$ref": "#/$defs/ValidatedMethod"
      }
    },
    "not_implemented": {
      "type": "array",
      "description": "未实现的方法及原因（聚合自 03-coding-library）",
      "items": {
        "$ref": "#/$defs/NotImplementedEntry"
      }
    },
    "quality_issues": {
      "type": "array",
      "description": "质量问题列表（从运行态检测中提取 warning/fail 项）",
      "items": {
        "$ref": "#/$defs/QualityIssue"
      }
    },
    "files_created": {
      "type": "array",
      "description": "新建文件列表（03+04 合并去重）",
      "items": { "type": "string" }
    },
    "files_modified": {
      "type": "array",
      "description": "修改文件列表（03+04 合并去重）",
      "items": { "type": "string" }
    },
    "build_status": {
      "type": "string",
      "description": "库编译状态（来自 03-coding-library）",
      "enum": ["pass", "fail"]
    },
    "example_status": {
      "type": "string",
      "description": "Example 编译状态（来自 04-testing）。unknown: 04 阶段产物缺失",
      "enum": ["pass", "skip", "fail", "unknown"]
    },
    "runtime_check_summary": {
      "$ref": "#/$defs/RuntimeCheckSummary",
      "description": "静态深度分析结果汇总（聚合自 04-testing.runtime_checks）"
    },
    "device_test_summary": {
      "$ref": "#/$defs/DeviceTestSummary",
      "description": "设备运行态验证结果汇总（聚合自 04-testing 的 device_test_* 字段）"
    },
    "risk_items": {
      "type": "array",
      "description": "风险项列表（搬运自 02-planning.risk_items）",
      "items": {
        "$ref": "#/$defs/RiskItem"
      }
    },
    "adaptation_stats": {
      "$ref": "#/$defs/AdaptationStats",
      "description": "适配统计数据"
    },
    "known_limitations": {
      "type": "array",
      "description": "已知限制列表",
      "items": { "type": "string" }
    },
    "recommendations": {
      "type": "array",
      "description": "改进建议列表",
      "items": { "type": "string" }
    },
    "has_integration_guide": {
      "type": "boolean",
      "description": "是否已生成 INTEGRATION_GUIDE.md"
    },
    "compilation_fixes": {
      "type": "array",
      "description": "编译修复记录（合并 03+04 阶段的修复记录）",
      "items": {
        "type": "object",
        "required": ["phase", "error", "fix"],
        "properties": {
          "phase": {
            "type": "string",
            "description": "所属阶段（coding-library 或 testing）"
          },
          "attempt": {
            "type": "integer",
            "description": "编译尝试次数",
            "minimum": 1
          },
          "error": {
            "type": "string",
            "description": "编译错误描述"
          },
          "fix": {
            "type": "string",
            "description": "修复方法描述"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Summary": {
      "type": "object",
      "description": "插件适配概况",
      "required": ["plugin_type", "plugin_architecture"],
      "properties": {
        "plugin_type": {
          "type": "string",
          "description": "插件类型（来自 01-analysis）",
          "enum": ["dart", "ffi", "plugin_method_channel", "plugin_event_channel", "plugin_platform_view", "plugin_texture", "plugin_mixed"]
        },
        "plugin_architecture": {
          "type": "string",
          "description": "插件架构（来自 01-analysis）",
          "enum": ["standalone", "federated", "monorepo"]
        },
        "plugin_type_skill": {
          "type": "string",
          "description": "使用的类型 Skill（来自 02-planning）"
        },
        "description": {
          "type": "string",
          "description": "插件功能描述"
        },
        "adaptation_approach": {
          "type": "string",
          "description": "适配方案概述（来自 02-planning.implementation_strategy.approach）"
        },
        "plugin_version": {
          "type": "string",
          "description": "插件版本（来自 01-analysis）"
        }
      },
      "additionalProperties": false
    },
    "Coverage": {
      "type": "object",
      "description": "方法覆盖率统计（聚合自 03-coding-library）",
      "required": ["total_methods", "implemented", "not_implemented", "coverage_rate"],
      "properties": {
        "total_methods": {
          "type": "integer",
          "description": "Channel 方法总数",
          "minimum": 0
        },
        "implemented": {
          "type": "integer",
          "description": "已实现方法数",
          "minimum": 0
        },
        "not_implemented": {
          "type": "integer",
          "description": "未实现方法数",
          "minimum": 0
        },
        "coverage_rate": {
          "type": "string",
          "description": "覆盖率百分比（如 80%）"
        }
      },
      "additionalProperties": false
    },
    "ValidatedMethod": {
      "type": "object",
      "description": "已实现的方法（与 03-coding-library 的 ImplementedMethod 字段完全对齐）",
      "required": ["channel", "method", "status"],
      "properties": {
        "channel": {
          "type": "string",
          "description": "Channel 名称"
        },
        "method": {
          "type": "string",
          "description": "方法名"
        },
        "status": {
          "type": "string",
          "description": "实现状态",
          "const": "implemented"
        }
      },
      "additionalProperties": false
    },
    "NotImplementedEntry": {
      "type": "object",
      "description": "未实现的方法（与 03-coding-library 的 NotImplementedMethod 字段完全对齐）",
      "required": ["channel", "method", "reason"],
      "properties": {
        "channel": {
          "type": "string",
          "description": "Channel 名称"
        },
        "method": {
          "type": "string",
          "description": "方法名"
        },
        "reason": {
          "type": "string",
          "description": "未实现原因"
        }
      },
      "additionalProperties": false
    },
    "QualityIssue": {
      "type": "object",
      "description": "质量问题（从 04-testing.runtime_checks 中提取 warning/fail 项）",
      "required": ["severity", "file", "issue"],
      "properties": {
        "severity": {
          "type": "string",
          "description": "严重程度",
          "enum": ["warning", "error"]
        },
        "file": {
          "type": "string",
          "description": "问题所在文件路径"
        },
        "issue": {
          "type": "string",
          "description": "问题描述"
        }
      },
      "additionalProperties": false
    },
    "RuntimeCheckSummary": {
      "type": "object",
      "description": "运行态检测结果统计",
      "required": ["total", "pass", "warning", "fail"],
      "properties": {
        "total": {
          "type": "integer",
          "description": "检测项总数",
          "minimum": 0
        },
        "pass": {
          "type": "integer",
          "description": "通过项数",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "description": "警告项数",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "description": "失败项数",
          "minimum": 0
        },
        "details": {
          "type": "array",
          "description": "各检测项的结果（从 04-testing.runtime_checks 原样搬运）",
          "items": {
            "$ref": "#/$defs/RuntimeCheckItem"
          }
        }
      },
      "additionalProperties": false
    },
    "RuntimeCheckItem": {
      "type": "object",
      "description": "单项检测结果（与 04-testing.RuntimeCheck 结构一致）",
      "required": ["check_type", "status"],
      "properties": {
        "check_type": {
          "type": "string",
          "description": "检测类型",
          "enum": [
            "channel_consistency",
            "param_type_match",
            "permission_completeness",
            "async_error_handling",
            "missing_plugin_risk",
            "null_safety",
            "event_channel_lifecycle",
            "behavior_equivalence",
            "return_structure_match",
            "api_call_validity"
          ]
        },
        "status": {
          "type": "string",
          "description": "检测结果",
          "enum": ["pass", "warning", "fail"]
        },
        "details": {
          "type": "string",
          "description": "检测详情，warning/fail 时说明具体问题"
        }
      },
      "additionalProperties": false
    },
    "DeviceTestSummary": {
      "type": "object",
      "description": "设备运行态验证结果汇总",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "description": "设备验证总状态（来自 04-testing.device_test_status）",
          "enum": ["pass", "partial", "fail", "skipped", "unknown"]
        },
        "total_methods": {
          "type": "integer",
          "description": "参与设备验证的方法总数",
          "minimum": 0
        },
        "pass_count": {
          "type": "integer",
          "description": "设备验证通过的方法数",
          "minimum": 0
        },
        "fail_count": {
          "type": "integer",
          "description": "设备验证失败的方法数（assert_fail + error + not_executed）",
          "minimum": 0
        },
        "pass_rate": {
          "type": "string",
          "description": "设备验证通过率百分比（如 '80%'）"
        },
        "crash_detected": {
          "type": "boolean",
          "description": "是否检测到应用启动崩溃"
        },
        "skip_reason": {
          "type": "string",
          "description": "跳过原因（仅 skipped 时填写）"
        }
      },
      "additionalProperties": false
    },
    "RiskItem": {
      "type": "object",
      "description": "风险项（搬运自 02-planning.risk_items）",
      "required": ["description", "severity"],
      "properties": {
        "description": {
          "type": "string",
          "description": "风险描述"
        },
        "severity": {
          "type": "string",
          "description": "严重程度。high: 可能导致功能无法实现; medium: 有限制或降级; low: 轻微影响",
          "enum": ["high", "medium", "low"]
        },
        "mitigation": {
          "type": ["string", "null"],
          "description": "缓解方案"
        }
      },
      "additionalProperties": false
    },
    "AdaptationStats": {
      "type": "object",
      "description": "适配统计数据",
      "properties": {
        "api_mapping_count": {
          "type": "integer",
          "description": "API 映射条目数（来自 02-planning.ohos_api_mapping）",
          "minimum": 0
        },
        "api_confidence_distribution": {
          "type": "object",
          "description": "API 映射置信度分布",
          "properties": {
            "high": { "type": "integer", "minimum": 0 },
            "medium": { "type": "integer", "minimum": 0 },
            "low": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "compilation_fix_count": {
          "type": "integer",
          "description": "编译修复总次数（03+04 合计）",
          "minimum": 0
        },
        "library_fix_count": {
          "type": "integer",
          "description": "库代码修复次数（来自 04-testing.library_fixes）",
          "minimum": 0
        },
        "example_method_coverage_rate": {
          "type": "string",
          "description": "Example 对已实现方法的覆盖率（来自 04-testing.method_coverage.coverage_rate）"
        },
        "total_files_changed": {
          "type": "integer",
          "description": "总文件变更数（files_created + files_modified 去重后）",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
