{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ohos-adaptation/04.5-integration-test.schema.json",
  "title": "Integration Test Stage Output",
  "description": "Flutter 插件鸿蒙适配集成测试阶段（阶段 4.5）的产物。记录 HAP 设备部署、截图捕获、视觉分析、迭代修复过程。",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "test_status",
    "device_info",
    "iterations",
    "mcp_config_used"
  ],
  "properties": {
    "test_status": {
      "type": "string",
      "description": "集成测试最终状态",
      "enum": ["pass", "fail", "partial", "skip"]
    },
    "device_info": {
      "type": "object",
      "description": "测试设备信息",
      "required": ["device_id"],
      "properties": {
        "device_id": {
          "type": "string",
          "description": "hdc 设备 ID"
        },
        "device_model": {
          "type": "string",
          "description": "设备型号"
        },
        "ohos_version": {
          "type": "string",
          "description": "鸿蒙系统版本"
        }
      }
    },
    "iterations": {
      "type": "array",
      "description": "迭代记录数组",
      "items": {
        "type": "object",
        "required": ["iteration_number", "screenshot_path", "status"],
        "properties": {
          "iteration_number": {
            "type": "integer",
            "description": "迭代序号（从 1 开始）",
            "minimum": 1
          },
          "screenshot_path": {
            "type": "string",
            "description": "截图保存路径（相对路径）"
          },
          "analysis_result": {
            "type": "object",
            "description": "MCP/LLM 分析结果",
            "properties": {
              "ui_elements": {
                "type": "array",
                "description": "检测到的 UI 元素",
                "items": { "type": "string" }
              },
              "layout_structure": {
                "type": "string",
                "description": "布局结构描述"
              },
              "issues_detected": {
                "type": "array",
                "description": "检测到的问题",
                "items": { "type": "string" }
              }
            }
          },
          "issues_found": {
            "type": "array",
            "description": "与代码参考对比后发现的问题",
            "items": { "type": "string" }
          },
          "fixes_applied": {
            "type": "array",
            "description": "应用的修复方案",
            "items": {
              "type": "object",
              "properties": {
                "file": { "type": "string" },
                "description": { "type": "string" },
                "change": { "type": "string" }
              }
            }
          },
          "status": {
            "type": "string",
            "description": "本次迭代状态",
            "enum": ["pass", "fail", "retry"]
          }
        }
      }
    },
    "mcp_config_used": {
      "type": "object",
      "description": "MCP/LLM 配置信息",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "description": "分析工具类型",
          "enum": ["mcp", "subagent"]
        },
        "provider": {
          "type": "string",
          "description": "MCP 工具名称或多模态 LLM 提供商"
        },
        "model": {
          "type": "string",
          "description": "LLM 模型名称（如适用）"
        }
      }
    },
    "unresolved_issues": {
      "type": "array",
      "description": "未解决的遗留问题（达到最大迭代次数时）",
      "items": { "type": "string" }
    },
    "files_modified": {
      "type": "array",
      "description": "在集成测试过程中修改的文件",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
