{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ohos-adaptation/04-testing.schema.json",
  "title": "Testing Stage Output (droidrun)",
  "description": "Flutter 插件鸿蒙适配阶段4的产物（基于 droidrun 运行态验证）。记录 Example 工程适配、测试套件生成、droidrun 单用例串行执行、bug 修复循环与静态深度分析。",
  "version": "4.0.0",
  "type": "object",
  "required": [
    "example_build_status",
    "example_source",
    "files_modified",
    "build_attempts",
    "method_coverage"
  ],
  "properties": {
    "example_build_status": {
      "type": "string",
      "description": "Example 构建结果。pass: 编译成功; fail: 编译失败; skip: 无 example 且无法创建",
      "enum": ["pass", "fail", "skip"]
    },
    "example_source": {
      "type": "string",
      "description": "Example 工程来源。existing_adapted: 适配已有 example; new_created: 从零新建; skip: 跳过",
      "enum": ["existing_adapted", "new_created", "skip"]
    },
    "deps_without_ohos": {
      "type": "array",
      "description": "缺少 OHOS 支持的依赖列表",
      "items": { "type": "string" }
    },
    "fallback_applied": {
      "type": "array",
      "description": "已应用的回退方案列表",
      "items": { "$ref": "#/$defs/FallbackEntry" }
    },
    "files_created": {
      "type": "array",
      "description": "新建的文件列表（含 example 目录和库目录）",
      "items": { "type": "string" }
    },
    "files_modified": {
      "type": "array",
      "description": "修改的文件列表（含 example 目录和库目录）",
      "items": { "type": "string" }
    },
    "build_attempts": {
      "type": "integer",
      "description": "构建尝试次数（首次编译 = 1，每次修复后重新编译 +1）",
      "minimum": 0
    },
    "method_coverage": { "$ref": "#/$defs/MethodCoverage" },
    "compilation_fixes": {
      "type": "array",
      "description": "编译修复记录",
      "items": { "$ref": "#/$defs/CompilationFix" }
    },
    "runtime_checks": {
      "type": "array",
      "description": "静态深度分析结果（含原有 7 项基础检测 + 3 项库代码正确性检测）",
      "items": { "$ref": "#/$defs/RuntimeCheck" }
    },
    "library_fixes": {
      "type": "array",
      "description": "库代码修复记录（运行态验证过程中发现并修复的库/example bug）",
      "items": { "$ref": "#/$defs/LibraryFix" }
    },
    "build_log_summary": {
      "type": "string",
      "description": "编译过程关键输出摘要。成功时简述，失败时包含最终错误信息"
    },
    "test_suite_file": {
      "type": "string",
      "description": "droidrun 测试套件 JSON 相对路径（通常为 .ohos-adaptation/04-test-cases.json）"
    },
    "test_suite_summary": { "$ref": "#/$defs/TestSuiteSummary" },
    "droidrun_run": { "$ref": "#/$defs/DroidrunRun" },
    "case_results": {
      "type": "array",
      "description": "每条 droidrun 测试用例的执行结果（用例中心字段）",
      "items": { "$ref": "#/$defs/CaseResult" }
    },
    "fix_iterations": {
      "type": "array",
      "description": "修复循环记录。单用例串行执行下，每一轮诊断+修复+重跑对应一条",
      "items": { "$ref": "#/$defs/FixIteration" }
    },
    "device_test_status": {
      "type": "string",
      "description": "设备运行态验证总状态。pass: 全部用例验证通过; partial: 部分通过; fail: 启动崩溃或全部失败; skipped: 无设备跳过。由 case_results 聚合得出。",
      "enum": ["pass", "partial", "fail", "skipped"]
    },
    "device_test_skip_reason": {
      "type": "string",
      "description": "跳过设备验证的原因（仅 skipped 时填写），如 no_device、build_failed 等"
    },
    "device_test_results": {
      "type": "array",
      "description": "[兼容字段] 从 case_results 归并而来，供 05-summary 继续消费。新流程下首选字段是 case_results。",
      "items": { "$ref": "#/$defs/DeviceTestResult" }
    },
    "device_crash_detected": {
      "type": "boolean",
      "description": "是否检测到应用启动崩溃"
    },
    "device_crash_log": {
      "type": "string",
      "description": "崩溃日志摘要（仅崩溃时填写）"
    },
    "device_test_attempts": {
      "type": "integer",
      "description": "droidrun test 累计调用次数（所有用例、所有重跑之和）",
      "minimum": 0
    },
    "example_build_command": {
      "type": "string",
      "description": "Example 编译命令"
    },
    "example_build_artifacts": {
      "type": "array",
      "description": "构建产物信息",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "description": "产物文件路径" },
          "size": { "type": "string", "description": "文件大小（如「134 MB」）" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "FallbackEntry": {
      "type": "object",
      "description": "单个依赖的回退方案",
      "required": ["dep", "original_call", "fallback"],
      "properties": {
        "dep": { "type": "string", "description": "依赖名" },
        "original_call": { "type": "string", "description": "原调用方式" },
        "fallback": { "type": "string", "description": "回退方案描述" }
      },
      "additionalProperties": false
    },
    "MethodCoverage": {
      "type": "object",
      "description": "测试用例对库已实现方法的覆盖统计",
      "required": ["total_methods", "covered_methods", "coverage_rate"],
      "properties": {
        "total_methods": {
          "type": "integer",
          "description": "库已实现的方法总数（来自 03-coding-library.json 的 implemented_methods）",
          "minimum": 0
        },
        "covered_methods": {
          "type": "integer",
          "description": "被 case_results[].covered_apis 至少覆盖一次的方法数",
          "minimum": 0
        },
        "uncovered_methods": {
          "type": "array",
          "description": "未被任何用例覆盖的方法名列表",
          "items": { "type": "string" }
        },
        "coverage_rate": {
          "type": "string",
          "description": "覆盖率百分比，如 '85%'"
        }
      },
      "additionalProperties": false
    },
    "CompilationFix": {
      "type": "object",
      "description": "编译修复记录",
      "required": ["attempt", "error", "fix"],
      "properties": {
        "attempt": { "type": "integer", "description": "第几次编译尝试时出现此错误", "minimum": 1 },
        "error": { "type": "string", "description": "编译错误描述（错误信息摘要）" },
        "fix": { "type": "string", "description": "修复方法描述" }
      },
      "additionalProperties": false
    },
    "RuntimeCheck": {
      "type": "object",
      "description": "静态深度分析检测项",
      "required": ["check_type", "status"],
      "properties": {
        "check_type": {
          "type": "string",
          "description": "检测类型",
          "enum": [
            "channel_consistency",
            "param_type_match",
            "permission_completeness",
            "async_error_handling",
            "missing_plugin_risk",
            "null_safety",
            "event_channel_lifecycle",
            "behavior_equivalence",
            "return_structure_match",
            "api_call_validity"
          ]
        },
        "status": {
          "type": "string",
          "description": "检测结果",
          "enum": ["pass", "warning", "fail"]
        },
        "details": {
          "type": "string",
          "description": "检测详情，warning/fail 时说明具体问题"
        },
        "method_details": {
          "type": "array",
          "description": "逐方法的检测详情（behavior_equivalence 和 return_structure_match 使用）",
          "items": { "$ref": "#/$defs/MethodCheckDetail" }
        }
      },
      "additionalProperties": false
    },
    "MethodCheckDetail": {
      "type": "object",
      "description": "单个方法的检测详情",
      "required": ["method", "result"],
      "properties": {
        "method": { "type": "string", "description": "方法名" },
        "result": {
          "type": "string",
          "description": "检测结果。equivalent: 逻辑等价; partial: 核心路径等价但有遗漏; divergent: 逻辑显著不同; stub: 空实现; match: 结构匹配; mismatch: 结构不匹配; valid: API 调用有效; invalid: API 调用无效",
          "enum": ["equivalent", "partial", "divergent", "stub", "match", "mismatch", "valid", "invalid"]
        },
        "issue": {
          "type": "string",
          "description": "问题描述（非 equivalent/match/valid 时说明）"
        }
      },
      "additionalProperties": false
    },
    "DeviceTestResult": {
      "type": "object",
      "description": "[兼容字段] 设备上单个方法的运行态验证结果（method 派生自 case_results 的 covered_apis[0]）",
      "required": ["method", "result"],
      "properties": {
        "method": { "type": "string", "description": "方法名" },
        "result": {
          "type": "string",
          "description": "验证结果。pass: 执行成功且断言通过; assert_fail: 执行成功但断言失败; error: 执行抛异常; not_executed: 未被执行到",
          "enum": ["pass", "assert_fail", "error", "not_executed"]
        },
        "detail": {
          "type": "string",
          "description": "返回值摘要或错误详情"
        }
      },
      "additionalProperties": false
    },
    "LibraryFix": {
      "type": "object",
      "description": "库/example 代码修复记录",
      "required": ["file", "issue", "fix"],
      "properties": {
        "file": { "type": "string", "description": "修复的文件路径（相对于插件根目录）" },
        "issue": { "type": "string", "description": "发现的问题描述" },
        "fix": { "type": "string", "description": "修复方法描述" }
      },
      "additionalProperties": false
    },
    "TestSuiteSummary": {
      "type": "object",
      "description": "测试套件概览（从 04-test-cases.json 聚合）",
      "required": ["total_cases"],
      "properties": {
        "total_cases": { "type": "integer", "minimum": 0, "description": "用例总数" },
        "l0_cases": { "type": "integer", "minimum": 0 },
        "l1_cases": { "type": "integer", "minimum": 0 },
        "l2_cases": { "type": "integer", "minimum": 0 },
        "suite_id": { "type": "string", "description": "suite.id" },
        "app_package": { "type": "string", "description": "suite.app_package（bundleName）" }
      },
      "additionalProperties": false
    },
    "DroidrunRun": {
      "type": "object",
      "description": "droidrun 运行元信息",
      "properties": {
        "command": { "type": "string", "description": "最后一次执行命令（通常是单用例模式）" },
        "trajectory_dir": { "type": "string", "description": "suite 级轨迹目录" },
        "report_file": { "type": "string", "description": "报告文件路径（-r 指定）" },
        "version": { "type": "string", "description": "droidrun 版本号" },
        "finished_at": { "type": "string", "description": "最后一次跑完的 ISO 时间戳" },
        "execution_mode": {
          "type": "string",
          "enum": ["per_case_sequential", "suite_batch"],
          "description": "执行模式。per_case_sequential: 单用例串行（默认）; suite_batch: 一把跑（不推荐）"
        }
      },
      "additionalProperties": false
    },
    "CaseResult": {
      "type": "object",
      "description": "单条 droidrun 用例的执行结果（用例中心）",
      "required": ["case_id", "result"],
      "properties": {
        "case_id": { "type": "string", "description": "对应 04-test-cases.json 里的 test_cases[].id" },
        "title": { "type": "string", "description": "用例标题" },
        "level": { "type": "string", "enum": ["L0", "L1", "L2"] },
        "covered_apis": {
          "type": "array",
          "description": "从 action 中 (API: xxx) 提取的方法名",
          "items": { "type": "string" }
        },
        "result": {
          "type": "string",
          "description": "最终结果。pass: 通过; fail: UI 元素不符/断言失败; error: 启动崩溃或异常; not_executed: 因前置失败未执行",
          "enum": ["pass", "fail", "error", "not_executed"]
        },
        "attempts": { "type": "integer", "minimum": 0, "description": "该用例累计尝试次数（含修复后重跑）" },
        "step_results": {
          "type": "array",
          "description": "逐步执行结果",
          "items": { "$ref": "#/$defs/StepResult" }
        },
        "failure_reason": { "type": "string", "description": "失败具体原因摘要" },
        "failure_category": {
          "type": "string",
          "description": "失败分类",
          "enum": ["crash", "element_not_found", "assert_fail", "timeout", "other"]
        },
        "trajectory_path": { "type": "string", "description": "最后一次运行的单用例轨迹目录" },
        "fixed_by": {
          "type": "array",
          "description": "关联到 fix_iterations[].iteration（若曾被修复过）",
          "items": { "type": "integer", "minimum": 1 }
        }
      },
      "additionalProperties": false
    },
    "StepResult": {
      "type": "object",
      "description": "单步执行结果",
      "required": ["action", "status"],
      "properties": {
        "action": { "type": "string" },
        "checkpoint": { "type": "string" },
        "status": { "type": "string", "enum": ["pass", "fail", "skipped"] },
        "note": { "type": "string", "description": "失败时补充信息（UI 元素未找到 / 文本不匹配 等）" }
      },
      "additionalProperties": false
    },
    "FixIteration": {
      "type": "object",
      "description": "单轮修复记录",
      "required": ["iteration", "case_id", "fix_type", "diagnosis"],
      "properties": {
        "iteration": { "type": "integer", "minimum": 1 },
        "case_id": { "type": "string", "description": "当前轮修复针对的用例" },
        "diagnosis": { "type": "string", "description": "失败原因诊断" },
        "fix_type": {
          "type": "string",
          "enum": ["library", "example", "test_case_ui_name"],
          "description": "修复类型。library: 插件 ohos 库代码; example: Example Dart 代码; test_case_ui_name: 用例里 UI 元素名与 example 不一致（不得放宽 checkpoint）"
        },
        "files_changed": {
          "type": "array",
          "items": { "type": "string" },
          "description": "改动的文件路径列表"
        },
        "reentered": {
          "type": "boolean",
          "description": "是否已经重新 build+install+test（仅 library/example 需要重 build）"
        }
      },
      "additionalProperties": false
    }
  }
}
