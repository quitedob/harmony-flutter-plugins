{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rn-ohos-adaptation/plugins.schema.json",
  "title": "Plugins Registry",
  "description": "React Native 模块仓库列表管理文件，仅管理克隆状态，不存储适配进度",
  "version": "1.0.0",
  "type": "object",
  "required": ["plugins"],
  "properties": {
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PluginEntry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "PluginEntry": {
      "type": "object",
      "required": ["id", "name", "repoUrl", "status"],
      "properties": {
        "id": {
          "type": "string",
          "description": "唯一标识符，由后端生成"
        },
        "name": {
          "type": "string",
          "description": "模块名称，同时也是 repos-rn/ 下的目录名"
        },
        "repoUrl": {
          "type": "string",
          "description": "Git 仓库地址",
          "format": "uri"
        },
        "commitHash": {
          "type": "string",
          "description": "克隆/拉取时的 HEAD commit hash"
        },
        "cloneTime": {
          "type": ["string", "null"],
          "description": "克隆完成的 ISO 时间戳",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "description": "仅反映克隆状态，不涉及适配进度",
          "enum": ["initialized", "cloning", "cloned", "clone_failed"]
        }
      },
      "additionalProperties": false
    }
  }
}
