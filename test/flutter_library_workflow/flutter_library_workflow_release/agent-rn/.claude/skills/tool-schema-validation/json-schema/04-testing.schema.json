{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rn-ohos-adaptation/04-testing.schema.json",
  "title": "RN OHOS Stage 04 Example Generation (legacy filename: 04-testing)",
  "description": "example生成 阶段产物。文件名保持 04-testing.json 以兼容历史已跑库。",
  "type": "object",
  "additionalProperties": true,
  "required": ["success", "example_build_status"],
  "properties": {
    "success": { "type": "boolean" },
    "example_build_status": {
      "type": "string",
      "enum": ["pass", "fail", "skipped", "unknown", "skip"]
    },
    "example_source": {
      "type": "string",
      "enum": ["existing_adapted", "new_created", "unknown", "skip"]
    },
    "build_attempts": { "type": "integer", "minimum": 0 },
    "deps_without_ohos": {
      "type": "array",
      "items": { "type": "string" }
    },
    "fallback_applied": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files_created": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files_modified": {
      "type": "array",
      "items": { "type": "string" }
    },
    "method_coverage": {
      "type": "object",
      "additionalProperties": true
    },
    "compilation_fixes": {
      "type": "array",
      "items": { "type": "object" }
    },
    "build_log_summary": {
      "type": "string"
    },
    "bundle_name": {
      "type": "string",
      "description": "Example AppScope app.json5 bundleName，供 device-verify 使用"
    },
    "ability_name": {
      "type": "string",
      "description": "Example entry EntryAbility 名称"
    }
  }
}
