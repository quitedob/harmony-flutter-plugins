{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rn-ohos-adaptation/05-summary.schema.json",
  "title": "Summary Stage Output",
  "description": "React Native 模块鸿蒙适配总结阶段（阶段5）的产物。聚合前 4 阶段数据，包含质量评分、方法覆盖率、适配概况、风险项、统计数据和改进建议。",
  "version": "3.0.0",
  "type": "object",
  "required": [
    "plugin_name",
    "status",
    "quality_score",
    "coverage",
    "implemented_methods",
    "not_implemented",
    "files_created",
    "files_modified",
    "build_status",
    "example_status"
  ],
  "properties": {
    "plugin_name": { "type": "string" },
    "status": { "type": "string", "enum": ["success", "partial", "failed"] },
    "quality_score": { "type": "string", "enum": ["A", "B", "C", "D"] },
    "summary": { "$ref": "#/$defs/Summary" },
    "coverage": { "$ref": "#/$defs/Coverage" },
    "implemented_methods": {
      "type": "array",
      "items": { "$ref": "#/$defs/ValidatedMethod" }
    },
    "not_implemented": {
      "type": "array",
      "items": { "$ref": "#/$defs/NotImplementedEntry" }
    },
    "quality_issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/QualityIssue" }
    },
    "files_created": { "type": "array", "items": { "type": "string" } },
    "files_modified": { "type": "array", "items": { "type": "string" } },
    "build_status": { "type": "string", "enum": ["pass", "fail"] },
    "example_status": { "type": "string", "enum": ["pass", "skip", "fail", "unknown"] },
    "runtime_check_summary": { "$ref": "#/$defs/RuntimeCheckSummary" },
    "device_test_summary": { "$ref": "#/$defs/DeviceTestSummary" },
    "risk_items": { "type": "array", "items": { "$ref": "#/$defs/RiskItem" } },
    "adaptation_stats": { "$ref": "#/$defs/AdaptationStats" },
    "known_limitations": { "type": "array", "items": { "type": "string" } },
    "recommendations": { "type": "array", "items": { "type": "string" } },
    "has_integration_guide": { "type": "boolean" }
  },
  "additionalProperties": false,
  "$defs": {
    "Summary": {
      "type": "object",
      "required": ["plugin_type", "plugin_architecture"],
      "properties": {
        "plugin_type": { "type": "string", "enum": ["js_only", "turbo_module", "fabric_component", "native_mixed"] },
        "plugin_architecture": { "type": "string", "enum": ["standalone", "monorepo"] },
        "target_module_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["turbo-module", "fabric-component", "cpp-turbo-module", "fabric-cpp-component", "js-only"]
          },
          "description": "适配目标类型列表（一对多，来自 02-planning）"
        },
        "description": { "type": "string" },
        "adaptation_approach": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Coverage": {
      "type": "object",
      "required": ["total_methods", "implemented", "not_implemented", "coverage_rate"],
      "properties": {
        "total_methods": { "type": "integer", "minimum": 0 },
        "implemented": { "type": "integer", "minimum": 0 },
        "not_implemented": { "type": "integer", "minimum": 0 },
        "coverage_rate": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ValidatedMethod": {
      "type": "object",
      "required": ["channel", "method", "status"],
      "properties": {
        "channel": { "type": "string", "description": "TurboModule/FabricComponent 名称" },
        "method": { "type": "string" },
        "status": { "type": "string", "const": "implemented" }
      },
      "additionalProperties": false
    },
    "NotImplementedEntry": {
      "type": "object",
      "required": ["channel", "method", "reason"],
      "properties": {
        "channel": { "type": "string" },
        "method": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "QualityIssue": {
      "type": "object",
      "required": ["severity", "file", "issue"],
      "properties": {
        "severity": { "type": "string", "enum": ["warning", "error"] },
        "file": { "type": "string" },
        "issue": { "type": "string" }
      },
      "additionalProperties": false
    },
    "RuntimeCheckSummary": {
      "type": "object",
      "required": ["total", "pass", "warning", "fail"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "pass": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "details": {
          "type": "array",
          "items": { "$ref": "#/$defs/RuntimeCheckItem" }
        }
      },
      "additionalProperties": false
    },
    "RuntimeCheckItem": {
      "type": "object",
      "required": ["check_type", "status"],
      "properties": {
        "check_type": {
          "type": "string",
          "enum": [
            "turbo_module_consistency",
            "param_type_match",
            "permission_completeness",
            "async_error_handling",
            "missing_module_risk",
            "null_safety",
            "event_emitter_lifecycle",
            "behavior_equivalence",
            "return_structure_match",
            "api_call_validity"
          ]
        },
        "status": { "type": "string", "enum": ["pass", "warning", "fail"] },
        "details": { "type": "string" }
      },
      "additionalProperties": false
    },
    "DeviceTestSummary": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "partial", "fail", "skipped", "unknown"] },
        "total_methods": { "type": "integer", "minimum": 0 },
        "pass_count": { "type": "integer", "minimum": 0 },
        "fail_count": { "type": "integer", "minimum": 0 },
        "pass_rate": { "type": "string" },
        "crash_detected": { "type": "boolean" },
        "skip_reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "RiskItem": {
      "type": "object",
      "required": ["description", "severity"],
      "properties": {
        "description": { "type": "string" },
        "severity": { "type": "string", "enum": ["high", "medium", "low"] },
        "mitigation": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "AdaptationStats": {
      "type": "object",
      "properties": {
        "api_mapping_count": { "type": "integer", "minimum": 0 },
        "api_confidence_distribution": {
          "type": "object",
          "properties": {
            "high": { "type": "integer", "minimum": 0 },
            "medium": { "type": "integer", "minimum": 0 },
            "low": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "compilation_fix_count": { "type": "integer", "minimum": 0 },
        "library_fix_count": { "type": "integer", "minimum": 0 },
        "example_method_coverage_rate": { "type": "string" },
        "total_files_changed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
