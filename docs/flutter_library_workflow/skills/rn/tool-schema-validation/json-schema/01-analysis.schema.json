{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rn-ohos-adaptation/01-analysis.schema.json",
  "title": "Analysis Stage Output",
  "description": "React Native 模块鸿蒙适配分析阶段（阶段1）的结构化产物。包含模块类型、通信模式、依赖分析、复杂度评估等信息，供后续 planning/coding/summary 阶段消费。",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "plugin_name",
    "plugin_version",
    "description",
    "ohos_readiness",
    "arch_type",
    "module_types",
    "plugin_type",
    "plugin_architecture",
    "communication_patterns",
    "native_modules",
    "functionality",
    "native_dependencies",
    "rn_dependencies",
    "permissions",
    "has_example",
    "complexity_assessment",
    "supported_platforms",
    "code_metrics",
    "uses_old_arch",
    "uses_new_arch",
    "migration_needed"
  ],
  "properties": {
    "plugin_name": {
      "type": "string",
      "description": "模块名称，来自 package.json 的 name 字段"
    },
    "plugin_version": {
      "type": "string",
      "description": "模块版本，来自 package.json 的 version 字段"
    },
    "description": {
      "type": "string",
      "description": "模块功能一句话描述"
    },
    "ohos_readiness": {
      "$ref": "#/$defs/OhosReadiness"
    },
    "arch_type": {
      "type": "string",
      "description": "架构类型：js-only=纯JS, old-arch=仅旧架构, new-arch=仅新架构, mixed-arch=新旧混合, unknown=无法判定。codegenConfig 有效性判定包含顶层 name/type 及 libraries[0].name/type",
      "enum": ["js-only", "old-arch", "new-arch", "mixed-arch", "unknown"]
    },
    "arch_type_notes": {
      "type": ["string", "null"],
      "description": "arch_type 判定为 unknown 时的具体原因说明。当 arch_type 为 unknown 时必填，其他情况可为 null"
    },
    "module_types": {
      "type": "array",
      "description": "现状模块类型列表（一对多）",
      "items": {
        "type": "string",
        "enum": ["native-module", "native-ui-component", "turbo-module", "fabric-component", "cpp-turbo-module", "jsi-host-object", "expo-module"]
      }
    },
    "uses_old_arch": {
      "type": "boolean",
      "description": "是否使用旧架构 NativeModules"
    },
    "old_arch_modules": {
      "type": "array",
      "description": "旧架构模块列表",
      "items": {
        "$ref": "#/$defs/OldArchModule"
      }
    },
    "uses_new_arch": {
      "type": "boolean",
      "description": "是否使用新架构 TurboModule/Fabric"
    },
    "new_arch_specs": {
      "type": "array",
      "description": "已存在的新架构 Spec 详情列表，每个元素对应单个 Spec 文件",
      "items": {
        "type": "object",
        "required": ["spec_file_path", "spec_summary"],
        "properties": {
          "spec_file_path": { "type": "string", "description": "Spec 文件路径（单个文件）" },
          "spec_summary": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string", "description": "模块名/组件名" },
              "type": { "type": "string", "enum": ["turbo-module", "fabric-component"], "description": "Spec 类型" },
              "methods": { "type": "array", "items": { "type": "string" }, "description": "导出的方法名列表（简版）" },
              "method_details": {
                "type": "array",
                "description": "方法的完整类型信息，每项包含方法名、参数结构、返回值类型",
                "items": {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "name": { "type": "string", "description": "方法名" },
                    "args": { "type": ["object", "array", "string", "null"], "description": "参数结构描述（如类型、是否可选）" },
                    "return_type": { "type": "string", "description": "返回值类型" }
                  },
                  "additionalProperties": false
                }
              },
              "constants": {
                "type": ["array", "object", "null"],
                "description": "TurboModule 的 getConstants() 返回的常量结构（键名列表或对象描述）"
              },
              "events": {
                "type": "array",
                "description": "事件名列表",
                "items": { "type": "string" }
              },
              "props": {
                "type": "array",
                "description": "Fabric Component 的 Props 名列表（仅 type=fabric-component 时填写）",
                "items": { "type": "string" }
              },
              "commands": {
                "type": "array",
                "description": "Fabric Component 的 Command 名列表（仅 type=fabric-component 时填写）",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "migration_needed": {
      "type": "boolean",
      "description": "是否需要迁移或清理旧架构代码（arch_type=old-arch 或 mixed-arch 时为 true；鸿蒙基座不支持旧架构 Interop Layer）"
    },
    "plugin_type": {
      "type": "string",
      "description": "模块类型分类（兼容前端展示）。module_types 空数组时为 'js_only'，单值时转为下划线格式，多值（≥2）时为 'native_mixed'",
      "enum": ["js_only", "native_module", "native_ui_component", "turbo_module", "fabric_component", "cpp_turbo_module", "jsi_host_object", "expo_module", "native_mixed", "unknown"]
    },
    "plugin_architecture": {
      "type": "string",
      "description": "模块架构模式",
      "enum": ["standalone", "monorepo"]
    },
    "monorepo_packages": {
      "type": "array",
      "description": "monorepo 架构时各子包信息，非 monorepo 为空数组或省略",
      "items": {
        "$ref": "#/$defs/MonorepoPackage"
      }
    },
    "communication_patterns": {
      "type": "array",
      "description": "模块使用的通信模式列表",
      "items": {
        "type": "string",
        "enum": ["turbo_module", "fabric_component", "device_event_emitter", "cpp_turbo_module", "jsi_host_object"]
      }
    },
    "native_modules": {
      "type": "array",
      "description": "模块注册的所有 TurboModule / Fabric Component 列表",
      "items": {
        "$ref": "#/$defs/NativeModule"
      }
    },
    "fabric_components": {
      "type": "array",
      "description": "Fabric 自定义组件注册信息",
      "items": {
        "$ref": "#/$defs/FabricComponent"
      }
    },
    "cpp_bindings": {
      "type": "array",
      "description": "C++ TurboModule 绑定的 native 函数列表",
      "items": {
        "$ref": "#/$defs/CppBinding"
      }
    },
    "functionality": {
      "$ref": "#/$defs/Functionality"
    },
    "native_dependencies": {
      "$ref": "#/$defs/NativeDependencies"
    },
    "rn_dependencies": {
      "type": "array",
      "description": "RN npm 依赖列表及其鸿蒙适配状态",
      "items": {
        "$ref": "#/$defs/RnDependency"
      }
    },
    "permissions": {
      "$ref": "#/$defs/Permissions"
    },
    "harmony_package_class": {
      "type": ["string", "null"],
      "description": "package.json 中 harmony.autolinking.etsPackageClassName 名称，未配置时为 null"
    },
    "supported_platforms": {
      "type": "array",
      "description": "模块已支持的平台列表（如 [\"android\", \"ios\"]）",
      "items": {
        "type": "string",
        "enum": ["android", "ios", "web", "windows", "macos", "linux", "harmony"]
      }
    },
    "platform_checks": {
      "type": "array",
      "description": "代码中的平台判断逻辑",
      "items": {
        "$ref": "#/$defs/PlatformCheck"
      }
    },
    "deprecated_api_usage": {
      "type": "array",
      "description": "JS 废弃 API 使用检测结果。RN 0.72+ / React 18 移除的 API（如 ViewPropTypes、PropTypes from react），在鸿蒙运行时会触发 TypeError 导致白屏",
      "items": {
        "type": "object",
        "required": ["api", "source", "files", "severity", "fix_pattern"],
        "properties": {
          "api": { "type": "string", "description": "废弃 API 名称，如 ViewPropTypes、PropTypes、ColorPropType" },
          "source": { "type": "string", "description": "导入来源包名，如 react-native、react" },
          "files": {
            "type": "array",
            "description": "使用该废弃 API 的文件及行号列表，格式为 file:line",
            "items": { "type": "string" }
          },
          "severity": { "type": "string", "enum": ["fatal", "warning"], "description": "严重级别。fatal=模块加载阶段崩溃(白屏), warning=运行时可能出错" },
          "fix_pattern": { "type": "string", "description": "修复模式标识，供 coding-library 阶段自动修复使用" }
        },
        "additionalProperties": false
      }
    },
    "has_example": {
      "type": "boolean",
      "description": "是否包含示例应用"
    },
    "example_deps": {
      "type": "array",
      "description": "示例应用的额外依赖及鸿蒙状态",
      "items": {
        "$ref": "#/$defs/ExampleDep"
      }
    },
    "complexity_assessment": {
      "$ref": "#/$defs/ComplexityAssessment"
    },
    "code_metrics": {
      "$ref": "#/$defs/CodeMetrics"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "OldArchModule": {
      "type": "object",
      "description": "旧架构模块信息",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "description": "模块名称" },
        "type": {
          "type": "string",
          "enum": ["native-module", "native-ui-component"],
          "description": "模块类型"
        },
        "methods": {
          "type": "array",
          "description": "模块方法列表",
          "items": { "type": "string" }
        },
        "constants": {
          "type": "array",
          "description": "通过 getConstants() 暴露的常量键名列表",
          "items": { "type": "string" }
        },
        "events": {
          "type": "array",
          "description": "通过 DeviceEventEmitter / RCTEventEmitter 发送的事件名列表",
          "items": { "type": "string" }
        },
        "commands": {
          "type": "array",
          "description": "ViewManager 支持的命令名列表（通过 UIManager.dispatchViewManagerCommand 调用），仅 native-ui-component 时填写",
          "items": { "type": "string" }
        },
        "native_implementation_language": {
          "type": "string",
          "enum": ["java", "kotlin", "objc", "swift"],
          "description": "原生实现语言"
        },
        "source_file": { "type": ["string", "null"], "description": "定义文件路径" }
      },
      "additionalProperties": false
    },
    "OhosReadiness": {
      "type": "object",
      "description": "鸿蒙化就绪状态评估",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "description": "鸿蒙化总体状态",
          "enum": ["not_adapted", "partially_adapted", "fully_adapted"]
        },
        "in_repo_harmony_dir": {
          "type": "boolean",
          "description": "仓库内是否有 harmony/ 目录"
        },
        "in_package_harmony": {
          "type": "boolean",
          "description": "package.json 中是否有 harmony 配置（autolinking / codegenConfig）"
        },
        "in_reference_index": {
          "type": "boolean",
          "description": "是否在已适配索引中找到"
        },
        "reference_url": {
          "type": ["string", "null"],
          "description": "已适配版本的仓库 URL"
        },
        "in_local_repos": {
          "type": "boolean",
          "description": "repos-rn/ 下是否有已适配的同名模块"
        },
        "local_repo_name": {
          "type": ["string", "null"],
          "description": "本地已适配仓库的目录名"
        },
        "adapted_library_lookup": {
          "description": "已适配库检索结果，结构与 sub-rn-adapted-library subagent 输出完全一致",
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["steps_completed", "package_name", "status", "source"],
              "properties": {
                "steps_completed": {
                  "type": "array",
                  "description": "已按顺序实际执行到的检索步骤编号（1-4），与 subagent 输出一致",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "minItems": 1
                },
                "package_name": { "type": "string" },
                "status": { "type": "string" },
                "version": { "type": ["string", "null"] },
                "ohos_repo": { "type": ["string", "null"] },
                "repo_url": { "type": ["string", "null"] },
                "autolinking": { "type": ["boolean", "null"] },
                "source": { "type": "string" },
                "recommendation": { "type": ["string", "null"] }
              },
              "additionalProperties": true
            }
          ]
        },
        "notes": {
          "type": ["string", "null"],
          "description": "补充说明"
        }
      },
      "additionalProperties": false
    },
    "MonorepoPackage": {
      "type": "object",
      "description": "Monorepo 中的子包信息",
      "required": ["name", "path", "type", "is_main"],
      "properties": {
        "name": { "type": "string", "description": "子包名称" },
        "path": { "type": "string", "description": "相对路径" },
        "type": {
          "type": "string",
          "description": "子包类型（同 module_types 取值）",
          "enum": ["native-module", "native-ui-component", "turbo-module", "fabric-component", "cpp-turbo-module", "jsi-host-object"]
        },
        "is_main": { "type": "boolean", "description": "是否为主包" }
      },
      "additionalProperties": false
    },
    "NativeModule": {
      "type": "object",
      "description": "模块注册的单个 TurboModule 或 Fabric Component",
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "description": "原生模块类型",
          "enum": ["TurboModule", "FabricComponent"]
        },
        "name": {
          "type": "string",
          "description": "模块名称，必须精确匹配 JS Spec 中的定义"
        },
        "spec_file": {
          "type": "string",
          "description": "JS/TS Spec 声明文件路径"
        },
        "methods": {
          "type": "array",
          "description": "TurboModule 上注册的方法列表",
          "items": {
            "$ref": "#/$defs/ModuleMethod"
          }
        }
      },
      "additionalProperties": false
    },
    "ModuleMethod": {
      "type": "object",
      "description": "TurboModule 上的单个方法",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "description": "方法名" },
        "args": {
          "type": ["object", "array", "string", "null"],
          "description": "参数结构描述"
        },
        "return_type": { "type": "string", "description": "返回值类型" }
      },
      "additionalProperties": false
    },
    "FabricComponent": {
      "type": "object",
      "description": "Fabric 自定义组件注册信息",
      "required": ["component_name"],
      "properties": {
        "component_name": { "type": "string", "description": "组件名称（codegenNativeComponent 的第一个参数）" },
        "js_spec_file": { "type": "string", "description": "JS/TS Spec 声明文件路径" },
        "props": {
          "type": "array",
          "description": "组件接收的 Props 列表",
          "items": { "type": "string" }
        },
        "commands": {
          "type": "array",
          "description": "组件支持的 Commands 列表",
          "items": { "type": "string" }
        },
        "events": {
          "type": "array",
          "description": "组件触发的 Events 列表",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "CppBinding": {
      "type": "object",
      "description": "C++ TurboModule 绑定的 native 函数",
      "required": ["function_name", "signature", "source_file"],
      "properties": {
        "function_name": { "type": "string", "description": "native 函数名" },
        "signature": { "type": "string", "description": "函数签名" },
        "source_file": { "type": "string", "description": "定义所在的 C/C++ 文件" }
      },
      "additionalProperties": false
    },
    "Functionality": {
      "type": "object",
      "description": "模块功能概述和核心功能列表",
      "required": ["summary", "core_features"],
      "properties": {
        "summary": { "type": "string", "description": "模块解决什么问题的一句话概述" },
        "core_features": {
          "type": "array",
          "items": { "$ref": "#/$defs/CoreFeature" }
        }
      },
      "additionalProperties": false
    },
    "CoreFeature": {
      "type": "object",
      "description": "单个核心功能描述",
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "related_methods": { "type": "array", "description": "关联的 TurboModule 方法名", "items": { "type": "string" } },
        "android_apis": { "type": "array", "items": { "type": "string" } },
        "ios_apis": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "NativeDependencies": {
      "type": "object",
      "description": "各平台的原生三方库依赖",
      "properties": {
        "android": { "type": "array", "items": { "type": "string" } },
        "ios": { "type": "array", "items": { "type": "string" } },
        "cpp": { "type": "array", "items": { "type": "string" } },
        "harmony": { "type": "array", "items": { "type": "string" }, "description": "harmony/library/oh-package.json5 中的原生依赖" }
      },
      "additionalProperties": false
    },
    "RnDependency": {
      "type": "object",
      "description": "RN npm 依赖及鸿蒙适配状态",
      "required": ["name", "version_constraint", "is_native_module", "ohos_status"],
      "properties": {
        "name": { "type": "string", "description": "npm 包名" },
        "version_constraint": { "type": "string", "description": "版本约束" },
        "is_native_module": { "type": "boolean", "description": "是否含原生平台代码" },
        "ohos_status": {
          "type": "string",
          "enum": ["adapted", "not_adapted", "unknown", "not_needed"]
        },
        "reference_url": { "type": ["string", "null"] },
        "is_blocking": { "type": "boolean", "description": "该依赖是否阻塞鸿蒙适配（无替代方案且必须适配）" },
        "discovered_via": {
          "type": "string",
          "enum": ["package_json", "source_scan"],
          "description": "依赖的发现来源：package_json=在 dependencies/peerDependencies 中声明；source_scan=步骤5.0 源码扫描在 *.harmony.* 等平台覆盖文件中发现但 package.json 未声明（运行时会 require 的原生依赖，必须并入以便 planning 解析、testing 注册原生模块）"
        },
        "imported_from": {
          "type": ["string", "null"],
          "description": "当 discovered_via=source_scan 时，引入该依赖的源码文件路径（如 src/refreshableScrollView.harmony.js）"
        },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "Permissions": {
      "type": "object",
      "properties": {
        "android": { "type": "array", "items": { "type": "string" } },
        "ios": { "type": "array", "items": { "type": "string" } },
        "harmony": { "type": "array", "items": { "type": "string" }, "description": "harmony/library/src/main/module.json5 中的权限声明" }
      },
      "additionalProperties": false
    },
    "PlatformCheck": {
      "type": "object",
      "required": ["file", "check_type"],
      "properties": {
        "file": { "type": "string" },
        "line_range": { "type": "string" },
        "check_type": { "type": "string", "description": "判断类型（如 Platform.OS、Platform.select、条件 require）" },
        "code_snippet": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ExampleDep": {
      "type": "object",
      "required": ["name", "ohos_status"],
      "properties": {
        "name": { "type": "string" },
        "ohos_status": { "type": "string", "enum": ["adapted", "not_adapted", "unknown", "not_needed"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "ComplexityAssessment": {
      "type": "object",
      "required": ["level", "factors", "complexity_score", "estimated_effort", "adaptation_recommendation"],
      "properties": {
        "level": { "type": "string", "enum": ["low", "medium", "high", "very_high"] },
        "factors": { "$ref": "#/$defs/ComplexityFactors" },
        "complexity_score": { "type": "integer", "minimum": 0, "maximum": 20 },
        "estimated_effort": { "type": "string" },
        "adaptation_recommendation": { "type": "string", "enum": ["proceed", "proceed_with_caution", "blocked", "not_needed"] },
        "blocking_reasons": { "type": "array", "items": { "type": "string" } },
        "risk_items": { "type": "array", "items": { "$ref": "#/$defs/RiskItem" } }
      },
      "additionalProperties": false
    },
    "ComplexityFactors": {
      "type": "object",
      "properties": {
        "turbo_module_method_count": { "type": "integer", "description": "TurboModule 方法总数", "minimum": 0 },
        "native_dependency_count": { "type": "integer", "description": "原生三方库依赖总数，统计口径为 native_dependencies 所有平台（android + ios + cpp + harmony）的条目数之和", "minimum": 0 },
        "blocking_deps_count": { "type": "integer", "description": "阻塞性 npm 依赖数量，统计口径为 rn_dependencies 中 is_blocking = true 的条目数", "minimum": 0 },
        "communication_pattern_count": { "type": "integer", "description": "通信模式种类数，统计口径为 communication_patterns 数组的长度", "minimum": 0 },
        "fabric_component_count": { "type": "integer", "description": "Fabric 组件数量", "minimum": 0 },
        "has_fabric_component": { "type": "boolean", "description": "是否使用 Fabric 自定义组件" },
        "has_cpp_module": { "type": "boolean", "description": "是否使用 C++ TurboModule" },
        "has_jsi_host_object": { "type": "boolean", "description": "是否使用直接 JSI 绑定（非 TurboModule 的 HostObject）" },
        "platform_check_count": { "type": "integer", "description": "平台判断代码出现次数，统计口径为 platform_checks 数组的长度", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "CodeMetrics": {
      "type": "object",
      "properties": {
        "file_counts": {
          "type": "object",
          "properties": {
            "javascript": { "type": "integer", "description": "src/ 下 JS/TS 文件数", "minimum": 0 },
            "android": { "type": "integer", "description": "android/ 下 Java/Kotlin 文件数", "minimum": 0 },
            "ios": { "type": "integer", "description": "ios/ 下 Swift/ObjC 文件数", "minimum": 0 },
            "cpp": { "type": "integer", "description": "C/C++ 文件数", "minimum": 0 },
            "harmony_ets": { "type": "integer", "description": "harmony/ 下 ETS 文件数", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "line_counts": {
          "type": "object",
          "properties": {
            "javascript": { "type": "integer", "description": "JS/TS 代码行数", "minimum": 0 },
            "android": { "type": "integer", "description": "android/ 下 Java/Kotlin 代码行数", "minimum": 0 },
            "ios": { "type": "integer", "description": "ios/ 下 Swift/ObjC 代码行数", "minimum": 0 },
            "cpp": { "type": "integer", "description": "C/C++ 代码行数", "minimum": 0 },
            "harmony_ets": { "type": "integer", "description": "harmony/ 下 ETS 代码行数", "minimum": 0 },
            "example": { "type": "integer", "description": "示例应用代码行数", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "RiskItem": {
      "type": "object",
      "required": ["description", "severity"],
      "properties": {
        "description": { "type": "string" },
        "severity": { "type": "string", "enum": ["high", "medium", "low"] },
        "mitigation": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
