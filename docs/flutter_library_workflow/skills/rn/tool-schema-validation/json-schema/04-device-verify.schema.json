{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rn-ohos-adaptation/04-device-verify.schema.json",
  "title": "RN OHOS Stage 04 Device Verification",
  "description": "测试验证（device-verify）阶段产物：Hypium/ohosTest、静态深度分析、真机 onDeviceTest、库修复记录。",
  "version": "1.0.0",
  "type": "object",
  "required": ["success"],
  "properties": {
    "success": { "type": "boolean" },
    "runtime_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/RuntimeCheck" }
    },
    "library_fixes": {
      "type": "array",
      "items": { "$ref": "#/$defs/LibraryFix" }
    },
    "test_scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/TestScenario" }
    },
    "device_test_status": { "type": "string", "enum": ["pass", "partial", "fail", "skipped"] },
    "device_test_skip_reason": { "type": "string" },
    "device_test_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/DeviceTestResult" }
    },
    "device_hilog_path": { "type": "string" },
    "device_hilog_excerpt": { "type": "string" },
    "device_crash_detected": { "type": "boolean" },
    "device_crash_log": { "type": "string" },
    "device_test_attempts": { "type": "integer", "minimum": 0 },
    "device_test_fast_fail": { "type": "boolean" },
    "device_test_fast_fail_log": { "type": "string" },
    "files_created": { "type": "array", "items": { "type": "string" } },
    "files_modified": { "type": "array", "items": { "type": "string" } },
    "build_log_summary": { "type": "string" }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": { "device_test_attempts": { "type": "integer", "minimum": 1 } },
        "required": ["device_test_attempts"]
      },
      "then": {
        "required": ["device_test_status", "device_test_results"]
      }
    },
    {
      "if": {
        "properties": { "device_test_status": { "const": "skipped" } },
        "required": ["device_test_status"]
      },
      "then": {
        "required": ["device_test_skip_reason"]
      }
    }
  ],
  "$defs": {
    "RuntimeCheck": {
      "type": "object",
      "required": ["check_type", "status"],
      "properties": {
        "check_type": {
          "type": "string",
          "enum": [
            "turbo_module_consistency",
            "param_type_match",
            "permission_completeness",
            "async_error_handling",
            "missing_module_risk",
            "null_safety",
            "event_emitter_lifecycle",
            "behavior_equivalence",
            "return_structure_match",
            "api_call_validity"
          ]
        },
        "status": { "type": "string", "enum": ["pass", "warning", "fail"] },
        "details": { "type": "string" },
        "method_details": {
          "type": "array",
          "items": { "$ref": "#/$defs/MethodCheckDetail" }
        }
      },
      "additionalProperties": false
    },
    "MethodCheckDetail": {
      "type": "object",
      "required": ["method", "result"],
      "properties": {
        "method": { "type": "string" },
        "result": { "type": "string", "enum": ["equivalent", "partial", "divergent", "stub", "match", "mismatch", "valid", "invalid"] },
        "issue": { "type": "string" }
      },
      "additionalProperties": false
    },
    "DeviceTestResult": {
      "type": "object",
      "required": ["method", "result"],
      "properties": {
        "method": { "type": "string" },
        "result": { "type": "string", "enum": ["pass", "assert_fail", "error", "not_executed"] },
        "detail": { "type": "string" },
        "suggested_owner": {
          "type": "string",
          "enum": ["test", "example", "library", "environment"]
        },
        "failure_owner": {
          "type": "string",
          "enum": ["test", "example", "library", "environment", "unknown"]
        },
        "triage_note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "LibraryFix": {
      "type": "object",
      "required": ["file", "issue", "fix"],
      "properties": {
        "file": { "type": "string" },
        "issue": { "type": "string" },
        "fix": { "type": "string" }
      },
      "additionalProperties": false
    },
    "TestScenario": {
      "type": "object",
      "required": ["name", "methods_tested"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "methods_tested": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
