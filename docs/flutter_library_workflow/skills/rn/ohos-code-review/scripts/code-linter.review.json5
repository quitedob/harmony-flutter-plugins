{
  // 审查专用 CodeLinter 配置（比 scaffold 默认更宽，启用清单可映射规则）。
  // ⚠️ 规则名是否真正生效由 review-scan.cjs 的完整性自检（fixture）确认；
  //    实测：裸 quotes/no-magic-numbers/curly 静默失效，须用 @typescript-eslint/* 变体。
  // RN 专属：库 TurboModule 主逻辑有的 repo 写在 .ts（如 *TurboModule.ts），故 files 含 **/*.ts；
  //          codegen 产物在 generated/ 不审查，统一在此 ignore，避免 CodeLinter 扫到生成代码。
  "files": ["**/*.ets", "**/*.ts"],
  "ignore": [
    "**/generated/**/*",
    "**/src/ohosTest/**/*",
    "**/src/test/**/*",
    "**/src/mock/**/*",
    "**/node_modules/**/*",
    "**/oh_modules/**/*",
    "**/build/**/*",
    "**/.preview/**/*",
    "**/BuildProfile.ets"
  ],
  "ruleSet": ["plugin:@typescript-eslint/recommended"],
  "rules": {
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-cond-assign": ["error", "always"],
    "use-isnan": "error",
    "no-unsafe-finally": "error",
    "one-var": ["warn", "never"],
    "@typescript-eslint/no-array-constructor": "error",
    "@typescript-eslint/naming-convention": [
      "warn",
      { "selector": "class", "format": ["PascalCase"] },
      { "selector": "enum", "format": ["PascalCase"] }
    ],
    "@typescript-eslint/no-magic-numbers": [
      "warn",
      { "ignore": [0, 1, -1], "ignoreArrayIndexes": true, "ignoreEnums": true, "ignoreReadonlyClassProperties": false }
    ],
    "@typescript-eslint/quotes": ["warn", "single", { "avoidEscape": true, "allowTemplateLiterals": true }],
    "@typescript-eslint/array-type": ["warn", { "default": "array" }],
    "@typescript-eslint/keyword-spacing": "warn",
    "@typescript-eslint/dot-notation": "warn",
    "@typescript-eslint/prefer-for-of": "warn",
    "max-len": ["warn", { "code": 120, "ignoreUrls": true, "ignoreStrings": false }],
    "@security/no-unsafe-hash": "error",
    "@security/no-unsafe-aes": "error",
    "@security/no-unsafe-mac": "warn",
    "@security/no-unsafe-3des": "error"
  }
}
