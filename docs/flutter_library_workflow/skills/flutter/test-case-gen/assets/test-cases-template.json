{
  "$schema": "../.claude/skills/tool-schema-validation/json-schema/04-test-cases.schema.json",
  "suite": {
    "id": "{plugin_name}_test_suite",
    "name": "{plugin_name} 测试套件",
    "app_package": "{app_package}",
    "app_card": "file:./{plugin_name}.md"
  },
  "modules": [
    {
      "moduleCode": "F-01",
      "moduleName": "{模块名称}",
      "moduleDescription": "{模块描述}",
      "priority": "{P0/P1/P2}",
      "test_cases": [
        {
          "id": "F01-001",
          "title": "{测试标题}",
          "level": "{L0/L1/L2/L3}",
          "preconditions": "{前置条件}",
          "test_steps": [
            {
              "action": "{操作描述}",
              "checkpoint": "{验证点}"
            }
          ],
          "expected_result": "{预期结果}",
          "postconditions": "{后置条件}"
        }
      ]
    }
  ]
}
