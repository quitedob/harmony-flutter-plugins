{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ohos-adaptation/04-test-cases.schema.json",
  "title": "Test Cases Output",
  "description": "测试用例生成阶段产物。基于测试分析报告生成的黑盒测试用例，包含测试套件定义、模块划分和具体测试步骤。",
  "version": "1.0.0",
  "type": "object",
  "required": ["suite", "modules"],
  "additionalProperties": true,
  "properties": {
    "suite": {
      "type": "object",
      "required": ["id", "name", "app_package", "app_card"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "app_package": { "type": "string" },
        "app_card": { "type": "string" }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["moduleCode", "moduleName", "moduleDescription", "priority", "test_cases"],
        "additionalProperties": false,
        "properties": {
          "moduleCode": { "type": "string" },
          "moduleName": { "type": "string" },
          "moduleDescription": { "type": "string" },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2"]
          },
          "test_cases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "level", "preconditions", "test_steps", "expected_result", "postconditions"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "level": {
                  "type": "string",
                  "enum": ["L0", "L1", "L2", "L3"]
                },
                "preconditions": { "type": "string" },
                "test_steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["action", "checkpoint"],
                    "additionalProperties": false,
                    "properties": {
                      "action": { "type": "string" },
                      "checkpoint": { "type": "string" }
                    }
                  }
                },
                "expected_result": { "type": "string" },
                "postconditions": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}