{
  "$schema": "https://raw.githubusercontent.com/huawei-test-design-agent/schema/main/requirement.schema.json",
  "pluginInfo": {
    "name": "nice_image_view",
    "version": "1.0.5",
    "repository": "https://github.com/shehuan/NiceImageView",
    "license": "Apache-2.0",
    "supportedPlatforms": ["Android", "iOS", "OHOS", "Web", "Windows", "macOS", "Linux"],
    "pluginType": "ui_component",
    "originalType": "android_native_view",
    "description": "Flutter widget providing rounded corners, circle display, border, inner border, and mask overlay effects for images. Ported from Android NiceImageView library as a pure-Dart CustomPainter implementation."
  },
  "modules": [
    {
      "moduleCode": "F-01",
      "moduleName": "构造函数与初始化",
      "description": "支持代码创建和参数初始化，所有12个属性均提供默认值",
      "priority": "P0"
    },
    {
      "moduleCode": "F-02",
      "moduleName": "圆形展示模式",
      "description": "将图片裁剪为圆形区域展示，支持切换到矩形模式",
      "priority": "P0"
    },
    {
      "moduleCode": "F-03",
      "moduleName": "圆角半径控制",
      "description": "支持统一圆角和四角独立圆角两种配置方式",
      "priority": "P0"
    },
    {
      "moduleCode": "F-04",
      "moduleName": "边框绘制",
      "description": "支持外边框（矩形/圆形均支持）和内边框（仅圆形）",
      "priority": "P0"
    },
    {
      "moduleCode": "F-05",
      "moduleName": "边框覆盖控制",
      "description": "控制边框是否覆盖图片内容区域",
      "priority": "P1"
    },
    {
      "moduleCode": "F-06",
      "moduleName": "遮罩绘制",
      "description": "在图片裁剪区域上绘制纯色遮罩",
      "priority": "P1"
    }
  ],
  "apis": [
    {
      "name": "NiceImageView",
      "signature": "const NiceImageView({Key? key, ImageProvider? image, double? width, double? height, bool isCircle = false, bool isCoverSrc = false, double cornerRadius = 0, double cornerTopLeftRadius = 0, double cornerTopRightRadius = 0, double cornerBottomLeftRadius = 0, double cornerBottomRightRadius = 0, double borderWidth = 0, Color borderColor = Colors.white, double innerBorderWidth = 0, Color innerBorderColor = Colors.white, Color maskColor = Colors.transparent, BoxFit? fit})",
      "module": "F-01",
      "returnType": "Widget",
      "parameters": [
        {"name": "image", "type": "ImageProvider?", "default": "null"},
        {"name": "width", "type": "double?", "default": "null"},
        {"name": "height", "type": "double?", "default": "null"},
        {"name": "isCircle", "type": "bool", "default": "false"},
        {"name": "isCoverSrc", "type": "bool", "default": "false"},
        {"name": "cornerRadius", "type": "double", "default": "0.0"},
        {"name": "cornerTopLeftRadius", "type": "double", "default": "0.0"},
        {"name": "cornerTopRightRadius", "type": "double", "default": "0.0"},
        {"name": "cornerBottomRightRadius", "type": "double", "default": "0.0"},
        {"name": "cornerBottomLeftRadius", "type": "double", "default": "0.0"},
        {"name": "borderWidth", "type": "double", "default": "0.0"},
        {"name": "borderColor", "type": "Color", "default": "Colors.white"},
        {"name": "innerBorderWidth", "type": "double", "default": "0.0"},
        {"name": "innerBorderColor", "type": "Color", "default": "Colors.white"},
        {"name": "maskColor", "type": "Color", "default": "Colors.transparent"},
        {"name": "fit", "type": "BoxFit?", "default": "null（默认 BoxFit.cover）"}
      ]
    },
    {
      "name": "NiceImageViewPainter",
      "signature": "class NiceImageViewPainter extends CustomPainter (constructor with image + 13 rendering fields)",
      "module": "F-02",
      "returnType": "CustomPainter",
      "parameters": [
        {"name": "image", "type": "ui.Image?", "default": "null"},
        {"name": "isCircle", "type": "bool", "default": "false"},
        {"name": "isCoverSrc", "type": "bool", "default": "false"},
        {"name": "cornerRadius", "type": "double", "default": "0.0"},
        {"name": "borderWidth", "type": "double", "default": "0.0"},
        {"name": "borderColor", "type": "Color", "default": "Colors.white"},
        {"name": "innerBorderWidth", "type": "double", "default": "0.0"},
        {"name": "innerBorderColor", "type": "Color", "default": "Colors.white"},
        {"name": "maskColor", "type": "Color", "default": "Colors.transparent"}
      ]
    }
  ],
  "permissions": [],
  "usageScenarios": {
    "targetUsers": [
      "移动应用开发者",
      "跨平台应用开发者",
      "UI/UX设计师",
      "社交通信应用开发者"
    ],
    "scenarios": [
      {
        "scenario": "用户头像圆形展示",
        "description": "配合圆形模式+边框实现头像展示，支持双层边框装饰效果"
      },
      {
        "scenario": "卡片图片圆角展示",
        "description": "使用统一圆角或独立四角圆角展示图片，配合卡片式UI设计"
      },
      {
        "scenario": "图片状态遮罩",
        "description": "在图片上叠加半透明遮罩表达状态（已过期、已选中等）"
      },
      {
        "scenario": "组合头像展示",
        "description": "先生成组合Bitmap，再用圆形NiceImageView展示（类似钉钉群头像）"
      }
    ]
  }
}
