{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Failure Lessons Schema",
  "description": "编码失败经验总结库的数据结构定义",
  "type": "object",
  "required": ["version", "updated_at", "lessons"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stage", "category", "module_types", "error_type", "wrong_pattern", "fix_pattern", "reason"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(coding|testing)-[a-z]+-\\d{3}$"
          },
          "stage": {
            "type": "string",
            "enum": ["coding-library", "testing"]
          },
          "category": {
            "type": "string",
            "enum": ["import", "type", "permission", "cmake", "api", "config", "access", "runtime"]
          },
          "module_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "turbo-module",
                "cpp-turbo-module",
                "fabric-component",
                "fabric-cpp-component",
                "js-only",
                "native-module",
                "native-ui-component"
              ]
            },
            "minItems": 1
          },
          "error_type": {
            "type": "string",
            "minLength": 1
          },
          "wrong_pattern": {
            "type": "string",
            "minLength": 1
          },
          "fix_pattern": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "example_source": {
            "type": "string"
          }
        }
      }
    }
  }
}