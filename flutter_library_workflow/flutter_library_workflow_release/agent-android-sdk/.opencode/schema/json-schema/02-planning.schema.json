{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ohos-adaptation/02-planning.schema.json",
  "title": "SDK Work Unit Planning Marker Output",
  "description": "02 阶段 marker JSON。详细 work unit 编码计划写入 .ohos-adaptation/work_unit_plan/*.md。",
  "version": "3.0.0",
  "type": "object",
  "required": [
    "sdk_name",
    "status",
    "prd_index_path",
    "work_unit_plan_dir",
    "work_unit_plan_index_path",
    "work_unit_count",
    "planning_report_path"
  ],
  "properties": {
    "sdk_name": { "type": "string" },
    "status": { "type": "string", "enum": ["complete", "partial", "failed"] },
    "prd_index_path": { "type": "string" },
    "work_unit_plan_dir": { "type": "string" },
    "work_unit_plan_index_path": { "type": "string" },
    "work_unit_count": { "type": "integer", "minimum": 0 },
    "planner_subagent_used": { "type": "boolean" },
    "planning_report_path": { "type": "string" },
    "coverage_summary": {
      "type": "object",
      "properties": {
        "prd_count": { "type": "integer", "minimum": 0 },
        "covered_prd_count": { "type": "integer", "minimum": 0 },
        "new_work_unit_count": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "generated_at": { "type": "string" }
  },
  "additionalProperties": false
}
