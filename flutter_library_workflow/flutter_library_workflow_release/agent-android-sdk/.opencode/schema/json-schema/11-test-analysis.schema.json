{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SDK Test Analysis Stage Output",
  "description": "SDK 鸿蒙化适配测试分析阶段产物 Schema",
  "version": "1.0.0",
  "type": "object",
  "required": ["sdk_name", "sdk_version", "modules", "summary"],
  "properties": {
    "sdk_name": {
      "type": "string",
      "description": "SDK 名称"
    },
    "sdk_version": {
      "type": "string",
      "description": "SDK 版本"
    },
    "prp_source": {
      "type": "string",
      "description": "PRD 文件路径（相对 .ohos-adaptation/）",
      "default": "01-analysis-prd.md"
    },
    "analysis_source": {
      "type": "string",
      "description": "SDK 分析 JSON 路径（相对 .ohos-adaptation/）",
      "default": "01-analysis.json"
    },
    "sdk_type": {
      "type": "string",
      "description": "SDK 类型",
      "enum": ["platform_interaction", "business_feature", "data_processing", "ui_component", "native_library"],
      "default": "platform_interaction"
    },
    "modules": {
      "type": "array",
      "description": "功能模块列表",
      "items": {
        "type": "object",
        "required": ["moduleCode", "moduleName", "priority", "testPoints"],
        "properties": {
          "moduleCode": {
            "type": "string",
            "pattern": "^F-\\d{2}$",
            "description": "模块编号，如 F-01"
          },
          "moduleName": {
            "type": "string",
            "description": "模块名称"
          },
          "moduleDescription": {
            "type": "string",
            "description": "模块描述"
          },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2"],
            "description": "模块优先级"
          },
          "sdkType": {
            "type": "string",
            "description": "SDK 子类型",
            "enum": ["platform_interaction", "business_feature", "data_processing", "ui_component", "native_library"]
          },
          "testPoints": {
            "type": "array",
            "description": "测试点列表",
            "items": {
              "type": "object",
              "required": ["id", "testName", "level", "description", "checkpoint"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^F-\\d{2}-\\d{2}$",
                  "description": "测试点编号，如 F-01-01"
                },
                "testName": {
                  "type": "string",
                  "description": "测试点名称（使用功能视角描述）"
                },
                "level": {
                  "type": "string",
                  "enum": ["L0", "L1", "L2"],
                  "description": "测试点级别"
                },
                "description": {
                  "type": "string",
                  "description": "测试点详细描述"
                },
                "checkpoint": {
                  "type": "string",
                  "description": "验证点（具体判定标准）"
                },
                "coveredAPIs": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "覆盖的 API 列表"
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["totalModules", "totalTestPoints", "levelDistribution"],
      "properties": {
        "totalModules": {
          "type": "integer",
          "description": "功能模块总数"
        },
        "totalTestPoints": {
          "type": "integer",
          "description": "测试点总数"
        },
        "totalAPIs": {
          "type": "integer",
          "description": "API 接口总数"
        },
        "levelDistribution": {
          "type": "object",
          "properties": {
            "L0": { "type": "integer" },
            "L1": { "type": "integer" },
            "L2": { "type": "integer" }
          }
        },
        "levelPercentage": {
          "type": "object",
          "properties": {
            "L0": { "type": "string" },
            "L1": { "type": "string" },
            "L2": { "type": "string" }
          }
        }
      }
    }
  }
}